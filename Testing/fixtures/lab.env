# BufferCache 实验室环境单一事实源（2026-11-21 建立；hermes 就绪包 2.0 版）
# 适用：hermes 执行轨 + 主控 + 全部 L2 用例。各脚本/用例引用本文件，禁止另行硬编码扩散。
# 用法：bash `source Testing/fixtures/lab.env`；python `tools/labconf.py`（mx_runner/env_doctor 已接入）。
# 变更纪律：值变更只改此处，并同步 用例全景统计 §8 快照 + STATUS 变更记录（AGENTS §7 已登记）。

# ---- 运行时（2.0：podman 唯一；docker 回退退役，理由=宿主 docker daemon 长期停用+双轨漂移风险）----
BC_RT=podman                    # 唯一受支持运行时；缺失→NO_CONTAINER（全 L2 SKIP，不静默混用）
BC_RT_VERSION_MIN=4.0           # 最低版本（本机 6.1.4）

# ---- 镜像钉版（策略：只钉"最新成熟发布版"的稳定 major.minor 线，禁 :latest；更新走 env_doctor.py update）----
# 成熟版判据：上游 GA ≥30 天 + 非 RC/beta；监测 env_doctor.py monitor 比对上游最新 stable。
BC_IMG_REDIS=redis:7-alpine     # 钉 7-alpine 线（7.4.x）；8-alpine 待镜像源恢复后经 update 流升级+基线重建
BC_IMG_REDIS_TARGET_MAJOR=8     # 目标主版本（上游已 GA；解锁后 update 流处理）
BC_IMG_PROMETHEUS=prometheus:latest        # TODO 钉版：monitor 流查询 quay 最新 stable 后改钉
BC_IMG_GRAFANA=grafana:latest              # TODO 钉版（同上；当前镜像未在盘）
BC_IMG_REDIS_EXPORTER=oliver006/redis_exporter:latest  # TODO 钉版（当前镜像未在盘）
BC_IMG_TOXIPROXY=ghcr.io/shopify/toxiproxy:2.12.0      # 已钉 2.12.0 ✔ 范本
BC_IMG_MEMTIER=memtier_benchmark/memtier_benchmark:latest  # TODO 钉版（当前镜像未在盘）
BC_IMAGES_PINNED=2026-11-21     # 钉版基准日（monitor 据此报告新鲜度）

# ---- 连接/超时 ----
BC_REDIS_PASS=lab-password
BC_REDIS_HOST=127.0.0.1
BC_REDIS_PORT=6379
BC_LAB_CONTAINER=redis-bench-lab  # A1 基线容器（单节点独立，与哨兵演练栈分离）
BC_OUT=Testing/output
BC_CMD_TIMEOUT=120
BC_BENCH_TIMEOUT=300

# ---- 镜像源状态（监测用；变更随网络环境）----
BC_REGISTRY_NOTE=registry-1.docker.io 直连拒连/quay.io 通（2026-11-21 实证）；redis 上游版本查询走 hub.docker.com API 尝试，失败降级 SKIP
